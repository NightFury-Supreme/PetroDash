# PteroDash Docker Environment Configuration
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
# NEVER commit your real .env file to git.

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=CHANGE_THIS_strong_password_here
MONGO_INITDB_DATABASE=pterodash

# ===========================================
# BACKEND CONFIGURATION
# ===========================================
NODE_ENV=production
PORT=4000

# Full MongoDB connection string — update username/password to match above
MONGODB_URI=mongodb://admin:CHANGE_THIS_strong_password_here@mongodb:27017/pterodash?authSource=admin

# Generate a strong random string for JWT signing:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_THIS_generate_a_strong_random_secret

# ===========================================
# PTERODACTYL PANEL CONFIGURATION
# ===========================================
PTERO_BASE_URL=http://your-pterodactyl-panel:8080
PTERO_APP_API_KEY=ptla_your_pterodactyl_application_api_key

# ===========================================
# FRONTEND / REVERSE PROXY CONFIGURATION
# ===========================================
FRONTEND_URL=https://dashboard.example.com
NEXT_PUBLIC_API_BASE=
ALLOWED_DEV_ORIGINS=localhost:3000

# ===========================================
# REDIS CONFIGURATION
# ===========================================
# In docker-compose, 'redis' is the hostname of the redis service
REDIS_URL=redis://redis:6379
